{
  "name": "db_public_requirements",
  "version": "0.1.0",
  "description": "Public database of software requirements, tests and accelerators for people who code with AI agents. Includes the reqdb CLI.",
  "license": "MIT",
  "author": "Luis María González Gordon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luismariagonzalez/db_public_requirements.git"
  },
  "homepage": "https://joderestatodocogido.com/proyectos/requirements-db/",
  "bugs": {
    "url": "https://github.com/luismariagonzalez/db_public_requirements/issues"
  },
  "keywords": [
    "requirements",
    "ai-agents",
    "vibe-coding",
    "cli",
    "coding-agents"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reqdb": "cli/reqdb.mjs"
  },
  "scripts": {
    "dev": "node scripts/servir.mjs",
    "construir": "node scripts/construir.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "auditar": "npm audit --omit=dev --audit-level=high",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:ensayar": "node scripts/ensayar.mjs",
    "db:migrar": "node scripts/migrar.mjs",
    "db:migrar:aplicar": "node scripts/migrar.mjs --aplicar",
    "semilla:generar": "node scripts/generar_semilla.mjs",
    "semilla:cargar": "node scripts/sembrar.mjs",
    "semilla:herramientas": "node scripts/sembrar_herramientas.mjs",
    "ui:ensayar-colaborar": "node scripts/ensayar_ui_colaborar.mjs",
    "semilla:regulacion": "node scripts/sembrar_regulacion.mjs",
    "api:ensayar": "node scripts/ensayar_api.mjs",
    "semilla:generar-extras": "node scripts/generar_tests_aceleradores.mjs",
    "gemini:ensayar": "node scripts/ensayar_gemini.mjs",
    "gemini:revision": "node scripts/ensayar_revision_gemini.mjs",
    "semilla:recalibrar": "node scripts/recalibrar_prioridades.mjs",
    "cli": "node cli/reqdb.mjs"
  },
  "dependencies": {
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "pg": "^8.13.1"
  }
}
